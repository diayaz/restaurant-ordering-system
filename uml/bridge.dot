digraph bridge {
  rankdir=BT; nodesep=0.5; ranksep=0.65; 
  graph [fontname="DejaVu Sans", fontsize=11, bgcolor="white", dpi=150];
  node [shape=plaintext, fontname="DejaVu Sans", fontsize=10];
  edge [fontname="DejaVu Sans", fontsize=9, color="#444444"];
  "Receipt" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#fdf0e3" ALIGN="CENTER"><I>Receipt</I></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"># renderer: ReceiptRenderer</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ print(o: Order): String  {abstract}</TD></TR></TABLE>>];
"ShortReceipt" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#fdf0e3" ALIGN="CENTER"><B>ShortReceipt</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ print(o: Order): String</TD></TR></TABLE>>];
"DetailedReceipt" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#fdf0e3" ALIGN="CENTER"><B>DetailedReceipt</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ print(o: Order): String</TD></TR></TABLE>>];
"ReceiptRenderer" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#fdf0e3" ALIGN="CENTER"><FONT POINT-SIZE="10">&laquo;interface&raquo;</FONT><BR/><I>ReceiptRenderer</I></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ begin(title)<BR/>+ text(text)<BR/>+ row(left, right)<BR/>+ separator()<BR/>+ total(label, value)<BR/>+ end(): String</TD></TR></TABLE>>];
"ConsoleRenderer" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#fdf0e3" ALIGN="CENTER"><B>ConsoleRenderer</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">(plain-text box)</TD></TR></TABLE>>];
"HtmlRenderer" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#fdf0e3" ALIGN="CENTER"><B>HtmlRenderer</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">(HTML page)</TD></TR></TABLE>>];
subgraph cluster_a { label="Abstraction"; style=dashed; color="#999999"; fontsize=10; Receipt; ShortReceipt; DetailedReceipt; }
subgraph cluster_i { label="Implementation"; style=dashed; color="#999999"; fontsize=10; ReceiptRenderer; ConsoleRenderer; HtmlRenderer; }
"ShortReceipt" -> "Receipt" [arrowhead=onormal];
"DetailedReceipt" -> "Receipt" [arrowhead=onormal];
"ConsoleRenderer" -> "ReceiptRenderer" [arrowhead=onormal, style=dashed];
"HtmlRenderer" -> "ReceiptRenderer" [arrowhead=onormal, style=dashed];
"Receipt" -> "ReceiptRenderer" [arrowtail=odiamond, dir=back, arrowhead=vee, label="  bridge  ", constraint="false", penwidth="2", color="#b5402a", fontcolor="#b5402a"];
}